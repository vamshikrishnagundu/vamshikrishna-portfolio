
---
const links = [
  { label: "Home", href: "/" },
  { label: "Biography", href: "/biography" },
  { label: "Projects", href: "/projects" },
  { label: "Blog", href: "/blog" },
  { label: "Contact", href: "/#contact" },
];

const currentPath =
  Astro.url.pathname.replace(/\/+$/, "") || "/";
---

<header class="site-header">
  <nav class="navbar" aria-label="Main navigation">
    <a class="brand" href="/">Vamshikrishna Gundu</a>

    <div class="nav-links">
      {links.map((link) => {
        const isActive = currentPath === link.href ||
          (link.href === "/#contact" && currentPath === "/contact");

        return (
          <a
            href={link.href}
            class:list={["nav-link", { active: isActive }]}
            aria-current={isActive ? "page" : undefined}
          >
            {link.label}
          </a>
        );
      })}
    </div>
  </nav>
</header>

<style>
  :global(html) {
    scroll-behavior: smooth;
    scroll-padding-top: 100px;
  }

  :global(body) {
    margin: 0;
    font-family: "Inter", Arial, sans-serif;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    width: 100%;
    background: rgba(248, 250, 252, 0.98);
    border-bottom: 1px solid #e2e8f0;
    box-shadow: 0 2px 7px rgba(15, 23, 42, 0.06);
  }

  .navbar {
    max-width: 1288px;
    min-height: 70px;
    margin: 0 auto;
    padding: 12px 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .brand {
    color: #1e293b;
    font-size: 22px;
    font-weight: 750;
    text-decoration: none;
    white-space: nowrap;
    letter-spacing: -0.4px;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .nav-link {
    color: #1e293b;
    text-decoration: none;
    font-size: 16px;
    font-weight: 600;
    padding: 9px 14px;
    border-radius: 9px;
    position: relative;
    transition: background 0.2s, color 0.2s;
  }

  .nav-link:hover,
  .nav-link.active {
    color: #2563eb;
    background: #e6edff;
  }

  .nav-link.active::after {
    content: "";
    position: absolute;
    bottom: 4px;
    left: 14px;
    right: 14px;
    height: 3px;
    border-radius: 3px;
    background: #2563eb;
  }

  @media (max-width: 1350px) {
    .navbar {
      padding-left: 24px;
      padding-right: 24px;
    }
  }

  @media (max-width: 800px) {
    .navbar {
      flex-direction: column;
      gap: 10px;
    }

    .nav-links {
      gap: 5px;
      flex-wrap: wrap;
      justify-content: center;
    }

    .nav-link {
      font-size: 13px;
      padding: 8px;
    }

    .nav-link.active::after {
      left: 8px;
      right: 8px;
    }

    .brand {
      font-size: 20px;
    }
  }
</style>
