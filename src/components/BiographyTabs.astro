
---
const tabs = [
  { id: "experience", label: "Professional Experience" },
  { id: "education", label: "Education" },
  { id: "expertise", label: "Area of Expertise" },
  { id: "others", label: "Others" },
];
---

<div class="biography-tabs">
  <div class="tab-navigation" role="tablist" aria-label="Biography sections">
    {tabs.map((tab, index) => (
      <button
        type="button"
        id={`tab-${tab.id}`}
        class:list={["tab-button", { active: index === 0 }]}
        role="tab"
        aria-selected={index === 0 ? "true" : "false"}
        aria-controls={`panel-${tab.id}`}
        tabindex={index === 0 ? 0 : -1}
        data-tab={tab.id}
      >
        {tab.label}
      </button>
    ))}
  </div>

  <div id="panel-experience" class="tab-panel" role="tabpanel" aria-labelledby="tab-experience">
    <article class="info-card">
      <span class="date">2023 – 2024</span>
      <h3>Data Engineering & Analytics</h3>
      <h4>VIBHO Technologies</h4>
      <p>
        Worked on data engineering, SQL-based data processing,
        and analytical solutions supporting business reporting.
      </p>
      <div class="tags">
        <span>Python</span><span>SQL</span><span>Data Engineering</span>
      </div>
    </article>
  </div>

  <div id="panel-education" class="tab-panel" role="tabpanel" aria-labelledby="tab-education" hidden>
    <article class="info-card">
      <span class="date">2025 – 2027 (Expected)</span>
      <h3>Master (Bac+5) — Data Science & Analytics</h3>
      <h4>EPITA, Paris</h4>
      <p>Graduate studies in data science, machine learning, and data engineering.</p>
    </article>

    <article class="info-card">
      <span class="date">2018 – 2022</span>
      <h3>Bachelor of Technology — Computer Science & Engineering</h3>
      <h4>JNTU Hyderabad</h4>
    </article>
  </div>

  <div id="panel-expertise" class="tab-panel" role="tabpanel" aria-labelledby="tab-expertise" hidden>
    <article class="info-card">
      <h3>Technical Expertise</h3>
      <div class="tags">
        <span>Python</span><span>SQL</span><span>Apache Spark</span>
        <span>Apache Kafka</span><span>Apache Airflow</span>
        <span>AWS</span><span>Docker</span><span>Power BI</span>
        <span>Machine Learning</span><span>FastAPI</span>
      </div>
    </article>
  </div>

  <div id="panel-others" class="tab-panel" role="tabpanel" aria-labelledby="tab-others" hidden>
    <article class="info-card">
      <h3>Professional Interests</h3>
      <p>
        Building reliable data platforms, production-ready
        machine learning applications, and practical AI solutions.
      </p>
    </article>
  </div>
</div>

<script>
  const initializeTabs = () => {
    document.querySelectorAll<HTMLElement>(".biography-tabs").forEach((container) => {
      const buttons = Array.from(
        container.querySelectorAll<HTMLButtonElement>(".tab-button")
      );

      const activate = (selected: HTMLButtonElement) => {
        buttons.forEach((button) => {
          const active = button === selected;
          button.classList.toggle("active", active);
          button.setAttribute("aria-selected", String(active));
          button.tabIndex = active ? 0 : -1;

          const panel = container.querySelector<HTMLElement>(
            `#panel-${button.dataset.tab}`
          );
          if (panel) panel.hidden = !active;
        });
      };

      buttons.forEach((button, index) => {
        button.addEventListener("click", () => activate(button));

        button.addEventListener("keydown", (event) => {
          let next = index;
          if (event.key === "ArrowRight") next = (index + 1) % buttons.length;
          else if (event.key === "ArrowLeft") next = (index - 1 + buttons.length) % buttons.length;
          else if (event.key === "Home") next = 0;
          else if (event.key === "End") next = buttons.length - 1;
          else return;

          event.preventDefault();
          activate(buttons[next]);
          buttons[next].focus();
        });
      });
    });
  };

  initializeTabs();
  document.addEventListener("astro:page-load", initializeTabs);
</script>

<style>
  .biography-tabs {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 40px;
    box-shadow: 0 8px 24px #0f172a0d;
  }

  .tab-navigation {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-bottom: 2px solid #e2e8f0;
    gap: 10px;
    margin-bottom: 35px;
  }

  .tab-button {
    padding: 16px 8px;
    border: none;
    border-bottom: 3px solid transparent;
    background: transparent;
    color: #475569;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
  }

  .tab-button.active {
    color: #2563eb;
    border-bottom-color: #2563eb;
  }

  .info-card {
    background: #f8fafc;
    padding: 30px;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    margin-bottom: 20px;
  }

  .date {
    color: #64748b;
    font-size: 14px;
  }

  h3 {
    margin-bottom: 4px;
    font-size: 22px;
  }

  h4 {
    margin-top: 0;
    color: #475569;
    font-weight: 500;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 20px;
  }

  .tags span {
    padding: 6px 12px;
    border: 1px solid #bfdbfe;
    border-radius: 20px;
    background: #eff6ff;
    color: #1d4ed8;
    font-size: 13px;
  }

  .tab-panel[hidden] {
    display: none;
  }

  @media (max-width: 700px) {
    .biography-tabs {
      padding: 18px;
    }

    .tab-navigation {
      grid-template-columns: repeat(2, 1fr);
    }

    .info-card {
      padding: 20px;
    }
  }
</style>
