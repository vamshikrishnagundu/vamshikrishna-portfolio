
---
const email = "vamshikrishnagundufr@gmail.com";
const phone = "+33 7 45 72 34 59";
const linkedin = "https://www.linkedin.com/in/vamshikrishna-gundu/";

// Replace with your real Calendly event link after setup.
const calendly = "";

const contacts = [
  {
    label: "PHONE",
    value: phone,
    icon: "☎",
    href: "tel:+33745723459",
  },
  {
    label: "EMAIL",
    value: email,
    icon: "✉",
    href: `mailto:${email}`,
  },
  {
    label: "LINKEDIN",
    value: "Vamshikrishna Gundu",
    icon: "in",
    href: linkedin,
  },
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Contact Vamshikrishna Gundu for data and AI opportunities." />
    <title>Contact | Vamshikrishna Gundu</title>
  </head>

  <body>
    <main class="contact-section">
      <h1>Contact Me</h1>

      <div class="contact-grid">
        {contacts.map((item) => (
          <a
            class="contact-card"
            href={item.href}
            target={item.href.startsWith("https://") ? "_blank" : undefined}
            rel={item.href.startsWith("https://") ? "noopener noreferrer" : undefined}
          >
            <span class="icon">{item.icon}</span>
            <span class="details">
              <span class="label">{item.label}</span>
              <span class="value">{item.value}</span>
            </span>
          </a>
        ))}
      </div>

      <div class="meeting-row">
        {calendly ? (
          <a
            class="contact-card meeting-card"
            href={calendly}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="icon">▦</span>
            <span class="details">
              <span class="label">CALENDLY</span>
              <span class="value">Schedule a Meeting</span>
            </span>
          </a>
        ) : (
          <div class="contact-card meeting-card unavailable">
            <span class="icon">▦</span>
            <span class="details">
              <span class="label">CALENDLY</span>
              <span class="value">Booking Coming Soon</span>
            </span>
          </div>
        )}
      </div>

      <footer>
        © {new Date().getFullYear()} Vamshikrishna Gundu.
        <span>All rights reserved.</span>
      </footer>
    </main>
  </body>
</html>

<style>
  :global(body) {
    margin: 0;
    font-family: Arial, Helvetica, sans-serif;
    background: #f8fafc;
    color: #0f2345;
  }

  .contact-section {
    max-width: 1050px;
    margin: 0 auto;
    padding: 70px 24px 50px;
    text-align: center;
  }

  h1 {
    font-size: 30px;
    margin-bottom: 32px;
    font-weight: 600;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }

  .contact-card {
    min-width: 0;
    min-height: 96px;
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 20px;
    background: white;
    border: 1px solid #dce4ef;
    border-radius: 12px;
    box-shadow: 0 4px 12px rgba(0, 0, 0, .06);
    color: #102343;
    text-align: left;
    text-decoration: none;
    box-sizing: border-box;
    transition: background .25s ease,
                color .25s ease,
                transform .25s ease,
                box-shadow .25s ease;
  }

  a.contact-card:hover {
    background: #2563eb;
    color: white;
    transform: translateY(-5px);
    box-shadow: 0 12px 25px rgba(37, 99, 235, .2);
  }

  a.contact-card:focus-visible {
    outline: 3px solid #2563eb;
    outline-offset: 4px;
  }

  .icon {
    width: 50px;
    height: 50px;
    flex-shrink: 0;
    border-radius: 50%;
    border: 2px solid #dce4ef;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    font-weight: bold;
    color: #2563eb;
    background: #f8fafc;
  }

  .details {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }

  .label {
    font-size: 13px;
    letter-spacing: .5px;
    color: #64748b;
  }

  .value {
    font-size: 14px;
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  a.contact-card:hover .label {
    color: #dbeafe;
  }

  .meeting-row {
    display: flex;
    justify-content: center;
    margin-top: 22px;
  }

  .meeting-card {
    width: 310px;
    max-width: 100%;
  }

  .unavailable {
    opacity: .65;
    cursor: not-allowed;
  }

  footer {
    margin-top: 50px;
    color: #64748b;
    font-size: 15px;
    line-height: 1.8;
  }

  footer span {
    display: block;
  }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
      max-width: 500px;
      margin: auto;
    }
  }
</style>
